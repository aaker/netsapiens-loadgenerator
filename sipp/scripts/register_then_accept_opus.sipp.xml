<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--                                                                    -->
<!--  Register, wait for an incoming INVITE, answer it, and stream RTP  -->
<!--  from a pre-recorded PCAP. Codec negotiation:                      -->
<!--    - OPUS (PT 121) offered → reply with OPUS SDP, play opus.pcap   -->
<!--    - OPUS not offered      → reply with G.711a SDP, play g711a.pcap-->
<!--                                                                    -->
<!--  CSV field layout (same as device CSVs from server.js):            -->
<!--    field0  Display Name                                            -->
<!--    field1  SIP user (username only, no @domain)                    -->
<!--    field2  Domain                                                  -->
<!--    field3  Auth header  [authentication username=X password=Y]     -->
<!--                                                                    -->

<scenario name="Register then Accept with Opus/G.711a PCAP">

  <!-- ================================================================ -->
  <!-- Registration                                                      -->
  <!-- ================================================================ -->

  <nop>
    <action>
      <assign assign_to="5" value="0" />
    </action>
  </nop>

  <send retrans="1000" start_rtd="register">
    <![CDATA[

      REGISTER sip:[field2] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0] <sip:[field1]@[field2]>;tag=[call_number]
      To: <sip:[field1]@[field2]>
      CSeq: [cseq] REGISTER
      Call-ID: [call_id]
      Contact: <sip:[field1]@[local_ip]:[local_port]>
      Expires: [expires]
      User-Agent: "[field0 file="random_user_agents.csv"]"
      Accept-Language: en
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <recv response="407" auth="true" rtd="register">  </recv>

  <label id="10">  </label>
  <send retrans="1000" start_rtd="reregister">
    <![CDATA[

      REGISTER sip:[field2] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0] <sip:[field1]@[field2]>;tag=[call_number]
      To: <sip:[field1]@[field2]>
      CSeq: [cseq] REGISTER
      Call-ID: [call_id]
      Contact: <sip:[field1]@[local_ip]:[local_port]>
      Expires: [expires]
      User-Agent: SIPp/Linux
      Accept-Language: en
      [field3]
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <recv response="407" auth="true" optional="true" next="10">  </recv>

  <recv response="200" rtd="reregister">
    <action>
      <ereg regexp="[0-9]+" search_in="hdr" header="Expires:" assign_to="1" />
      <add assign_to="5" value="1"/>
      <subtract assign_to="1" value="15"/>
      <todouble assign_to="2" variable="1"/>
      <multiply assign_to="2" value="1000"/>
    </action>
  </recv>

  <!-- ================================================================ -->
  <!-- Wait for incoming INVITE (up to 60s after registration)          -->
  <!-- Save the INVITE Call-ID separately — it differs from [call_id]   -->
  <!-- which belongs to the REGISTER dialog.                            -->
  <!-- ================================================================ -->

  <recv request="INVITE" crlf="true" rrs="true" timeout="60000">
    <action>
      <ereg regexp=".*" search_in="hdr" header="From"    assign_to="remote_from"/>
      <ereg regexp="sip:(.*)>.*" search_in="hdr" header="Contact" assign_to="remote_contact"/>
      <ereg regexp=".*" search_in="hdr" header="Call-ID" assign_to="invite_callid"/>
      <!-- Non-empty if the caller offers OPUS (PT 121) -->
      <ereg regexp="a=rtpmap:121" search_in="body" assign_to="opus_offered" checkIt="false"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>

    ]]>
  </send>

  <pause distribution="uniform" min="1000" max="5000"/>

  <!-- Branch: OPUS offered → OPUS 200 OK; else → G.711a 200 OK -->
  <nop test="opus_offered" next="200ok_opus"/>

  <!-- G.711a 200 OK -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15

    ]]>
  </send>
  <nop next="recv_ack"/>

  <!-- OPUS 200 OK -->
  <label id="200ok_opus"/>
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 121 101
      a=rtpmap:121 opus/48000/2
      a=fmtp:121 minptime=10;useinbandfec=1
      a=rtpmap:101 telephone-event/48000
      a=fmtp:101 0-15

    ]]>
  </send>

  <label id="recv_ack"/>
  <recv request="ACK" rtd="true" crlf="true">
  </recv>

  <!-- ================================================================ -->
  <!-- RTP playback: branch on negotiated codec                         -->
  <!-- ================================================================ -->

  <nop test="opus_offered" next="play_opus"/>
  <nop>
    <action>
      <exec play_pcap_audio="g711a.pcap"/>
    </action>
  </nop>
  <nop next="wait_bye"/>

  <label id="play_opus"/>
  <nop>
    <action>
      <exec play_pcap_audio="opus.pcap"/>
    </action>
  </nop>

  <!-- ================================================================ -->
  <!-- BYE handling                                                      -->
  <!-- ================================================================ -->

  <label id="wait_bye"/>
  <recv request="BYE" timeout="400000" ontimeout="send_bye">
  </recv>
  <send next="99">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <!-- Timeout path: we send the BYE using the saved INVITE Call-ID -->
  <label id="send_bye"/>
  <send retrans="1000">
    <![CDATA[

      BYE [$remote_contact] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port]
      From: [field0] <sip:[field1]@[local_ip]:[local_port]>;tag=[pid]SIPpTag01[call_number]
      To: [$remote_from]
      Call-ID: [$invite_callid]
      CSeq: 2 BYE
      Contact: <sip:[field1]@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>
  <recv response="200" crlf="true" next="99">
  </recv>

  <label id="99"/>
  <timewait milliseconds="5000"/>

  <ResponseTimeRepartition value="2, 5, 10, 20, 30, 40, 50, 60, 70, 80, 100, 125, 150, 175, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 2000"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>

</scenario>
