<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--                                                                    -->
<!--  UAS responder with Opus/G.711a fallback and PCAP RTP playback.    -->
<!--  Designed for use as -oocsf alongside a registration scenario.     -->
<!--                                                                    -->
<!--  When SIPp receives an INVITE whose Call-ID doesn't match any      -->
<!--  existing call (i.e. a server-initiated inbound call), it spawns   -->
<!--  a new instance of this scenario to handle it. [call_id] is        -->
<!--  automatically set to the INVITE's Call-ID in this context.        -->
<!--                                                                    -->
<!--  Codec negotiation:                                                 -->
<!--    - OPUS (PT 121) offered → reply with OPUS SDP, play opus.pcap   -->
<!--    - OPUS not offered      → reply with G.711a SDP, play g711a.pcap-->
<!--                                                                    -->

<scenario name="UAS Accept with Opus/G.711a PCAP">

  <recv request="INVITE" crlf="true" rrs="true">
    <action>
      <ereg regexp=".*"          search_in="hdr" header="From"    assign_to="remote_from"/>
      <ereg regexp="sip:(.*)>.*" search_in="hdr" header="Contact" assign_to="remote_contact"/>
      <!-- Non-empty if caller offered OPUS (PT 121) -->
      <ereg regexp="a=rtpmap:121" search_in="body" assign_to="opus_offered" checkIt="false"/>
      <!-- Extract last 2 digits of call_number from Call-ID (always 00-99, cycles evenly). -->
      <!-- opus_pct must be zero-padded 2 digits (00-99) for correct string comparison.   -->
      <!-- strcmp: -1 if roll<pct → add1=0(falsy→Opus), 0 or 1 → add1≥1(truthy→G.711a). -->
      <ereg regexp="([0-9][0-9])-[0-9a-f]" search_in="hdr" header="Call-ID" assign_to="opus_roll,opus_roll" checkIt="false"/>
      <strcmp assign_to="cmp_result" variable="opus_roll" value="[opus_pct]"/>
      <add assign_to="cmp_result" value="1"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>

    ]]>
  </send>

  <pause distribution="uniform" min="1000" max="5000"/>

  <!-- Branch: OPUS offered AND percentage passes → OPUS 200 OK, else → G.711a 200 OK -->
  <nop test="opus_offered" next="check_pct"/>
  <nop next="200ok_g711a"/>

  <label id="check_pct"/>
  <!-- cmp_result=0 → opus_roll < opus_pct → Opus; non-zero → G.711a -->
  <nop test="cmp_result" next="200ok_g711a"/>
  <nop next="200ok_opus"/>

  <!-- G.711a 200 OK -->
  <label id="200ok_g711a"/>
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15

    ]]>
  </send>
  <nop>
    <action><assign assign_to="codec_opus" value="0"/></action>
  </nop>
  <nop next="recv_ack"/>

  <!-- OPUS 200 OK -->
  <label id="200ok_opus"/>
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 121 101
      a=rtpmap:121 opus/48000/2
      a=fmtp:121 minptime=10;useinbandfec=1
      a=rtpmap:101 telephone-event/48000
      a=fmtp:101 0-15

    ]]>
  </send>
  <nop>
    <action><assign assign_to="codec_opus" value="1"/></action>
  </nop>

  <label id="recv_ack"/>
  <recv request="ACK" rtd="true" crlf="true">
  </recv>

  <!-- RTP playback driven by what we actually negotiated -->
  <nop test="codec_opus" next="play_opus"/>
  <nop>
    <action>
      <exec play_pcap_audio="g711a.pcap"/>
    </action>
  </nop>
  <nop next="wait_bye"/>

  <label id="play_opus"/>
  <nop>
    <action>
      <exec play_pcap_audio="opus.pcap"/>
    </action>
  </nop>

  <label id="wait_bye"/>
  <recv request="BYE" timeout="400000" ontimeout="send_bye">
  </recv>
  <send next="99">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <!-- Timeout path: we send the BYE -->
  <label id="send_bye"/>
  <send retrans="1000">
    <![CDATA[

      BYE [$remote_contact] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag01[call_number]
      To: [$remote_from]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: <sip:sipp@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>
  <recv response="200" crlf="true" next="99">
  </recv>

  <label id="99"/>
  <timewait milliseconds="5000"/>

  <ResponseTimeRepartition value="2, 5, 10, 20, 30, 40, 50, 60, 70, 80, 100, 125, 150, 175, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 2000"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>

</scenario>
