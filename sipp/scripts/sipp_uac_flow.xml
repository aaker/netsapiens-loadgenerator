<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- ====================================================================== -->
<!-- Multi-section caller (UAC) for the manual_test.sh call flows.          -->
<!--                                                                        -->
<!-- Same call setup as sipp_uac_pcap_g711a.xml (DID INVITE, pre-agent      -->
<!-- silence + DTMF), then plays one pcap per section of the conversation,  -->
<!-- each section with a different agent (or set of agents).  manual_test  -->
<!-- fills in __SECTIONS__ (2-6) and __PCAPn__ / __LENn__ (seconds) for    -->
<!-- n = 1-6; sections past __SECTIONS__ are never reached.                -->
<!--                                                                        -->
<!-- Sections follow the re-INVITEs the core sends as the call moves        -->
<!-- (agent connect, hold, transfer, conference join), timed against        -->
<!-- absolute deadlines so a re-INVITE never resets a timer:                -->
<!--   - the first re-INVITE (agent connect) starts section 1               -->
<!--   - a sendrecv re-INVITE within 3s of a section's end, or after it,    -->
<!--     starts the next section                                            -->
<!--   - otherwise a sendrecv re-INVITE within 35s of a section's start     -->
<!--     restarts that section, so a hold/re-point + connect pair lines up  -->
<!--     on the connect                                                     -->
<!--   - no re-INVITE: the next section starts 32s after the end anyway     -->
<!--   - a=sendonly/inactive (hold) is answered recvonly/inactive and does  -->
<!--     not change the section                                             -->
<!-- The caller hangs up when the last section ends.  Waiting happens in    -->
<!-- 500ms recv slices (a re-INVITE during a <pause> would be auto-BYEd).   -->
<!-- ====================================================================== -->

<scenario name="UAC multi-section call flow (caller)">

  <!-- Send OPTIONS request to check server availability -->
  <send retrans="500" start_rtd="option">
    <![CDATA[

      OPTIONS sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 OPTIONS
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" rtd="option">
  </recv>

  <send retrans="500" start_rtd="invite">
    <![CDATA[

      INVITE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "[field0 file="random_caller_ids.csv"]" <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: sip:sipp@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[local_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-11,16

    ]]>
  </send>

  <recv response="100" rtd="invite" optional="true">
  </recv>

  <recv response="180" optional="true">
  </recv>

  <!-- By adding rrs="true" (Record Route Sets), the route sets         -->
  <!-- are saved and used for following messages sent. Useful to test   -->
  <!-- against stateful SIP proxies/B2BUAs.                             -->
  <recv response="200" crlf="true">
  </recv>

  <!-- Packet lost can be simulated in any send/recv message by         -->
  <!-- by adding the 'lost = "10"'. Value can be [1-100] percent.       -->
  <send>
    <![CDATA[

      ACK sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0 file="random_caller_ids.csv"] <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: sut <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: sip:[field1 file="random_caller_ids.csv"]@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Subject: Performance Test
      Content-Length: 0

    ]]>
  </send>

  <!-- Pre-agent stage (AA/MOH): the platform expects media from us, but   -->
  <!-- no agent is listening yet, so stream SILENCE rather than real       -->
  <!-- speech.  Caller speech starts at talk_leg when an agent connects.   -->
  <nop>
    <action>
      <!-- log lines only emit under -trace_logs (manual_test.sh); cron is unaffected -->
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-silence.pcap stage=pre-agent"/>
      <exec play_pcap_audio="pcaps/g711a-silence.pcap"/>
    </action>
  </nop>

  <!-- send rfc2833 DTMF.  NOTE: rtp_send_dtmf shares the pcap-audio media -->
  <!-- thread, so it KILLS the running playback - which is why silence is  -->
  <!-- restarted right after the digit below.                              -->
  <nop>
    <pause distribution="uniform" min="100" max="1000"/>
    <action>
      <exec rtp_send_dtmf="1" />
    </action>
  </nop>

  <!-- Let the DTMF digit finish, then resume the silence stream so RTP    -->
  <!-- keeps flowing until the agent-connect re-INVITE starts real speech. -->
  <!-- Kept short: a re-INVITE landing during a blocking pause would be    -->
  <!-- auto-BYEd (see below), and the agent can connect from ~1s onward.   -->
  <pause milliseconds="300"/>
  <nop>
    <action>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-silence.pcap stage=post-dtmf"/>
      <exec play_pcap_audio="pcaps/g711a-silence.pcap"/>
    </action>
  </nop>


  <nop>
    <action>
      <assign assign_to="k" value="0"/>
      <assign assign_to="cur_len" value="0"/>
      <assign assign_to="sstart" value="0"/>
      <gettimeofday assign_to="t_s,t_us"/>
      <assign assign_to="now" value="0"/>
      <add assign_to="now" variable="t_s"/>
      <assign assign_to="t_frac" value="0"/>
      <add assign_to="t_frac" variable="t_us"/>
      <divide assign_to="t_frac" value="1000000"/>
      <add assign_to="now" variable="t_frac"/>
    </action>
  </nop>

  <!-- Waiting for the first agent. -->
  <label id="wait_agent"/>
  <nop>
    <action>
      <assign assign_to="offer_sendonly" value="0"/>
      <assign assign_to="offer_inactive" value="0"/>
    </action>
  </nop>
  <recv timeout="45000" ontimeout="send_bye" request="BYE" optional="true" next="peer_bye">
  </recv>
  <recv request="INVITE" timeout="45000" ontimeout="send_bye" crlf="true" next="reinv">
    <action>
      <ereg regexp="a=sendonly" search_in="body" assign_to="offer_sendonly" checkIt="false"/>
      <ereg regexp="a=inactive" search_in="body" assign_to="offer_inactive" checkIt="false"/>
    </action>
  </recv>

  <!-- In a section: poll every 500ms. -->
  <label id="poll"/>
  <nop>
    <action>
      <assign assign_to="offer_sendonly" value="0"/>
      <assign assign_to="offer_inactive" value="0"/>
    </action>
  </nop>
  <recv timeout="500" ontimeout="tick" request="BYE" optional="true" next="peer_bye">
  </recv>
  <recv request="INVITE" timeout="500" ontimeout="tick" crlf="true" next="reinv">
    <action>
      <ereg regexp="a=sendonly" search_in="body" assign_to="offer_sendonly" checkIt="false"/>
      <ereg regexp="a=inactive" search_in="body" assign_to="offer_inactive" checkIt="false"/>
    </action>
  </recv>

  <!-- Deadlines: hang up after the last section; fall back to the next   -->
  <!-- section 32s after this one ended if no re-INVITE moved the call.   -->
  <label id="tick"/>
  <nop>
    <action>
      <gettimeofday assign_to="t_s,t_us"/>
      <assign assign_to="now" value="0"/>
      <add assign_to="now" variable="t_s"/>
      <assign assign_to="t_frac" value="0"/>
      <add assign_to="t_frac" variable="t_us"/>
      <divide assign_to="t_frac" value="1000000"/>
      <add assign_to="now" variable="t_frac"/>
      <assign assign_to="elapsed" value="0"/>
      <add assign_to="elapsed" variable="now"/>
      <subtract assign_to="elapsed" variable="sstart"/>
      <assign assign_to="over" value="0"/>
      <add assign_to="over" variable="elapsed"/>
      <subtract assign_to="over" variable="cur_len"/>
      <test assign_to="ended" variable="over" compare="greater_than_equal" value="0"/>
      <test assign_to="stalled" variable="over" compare="greater_than_equal" value="32"/>
      <test assign_to="is_last" variable="k" compare="greater_than_equal" value="__SECTIONS__"/>
    </action>
  </nop>
  <nop test="is_last" next="tick_last"/>
  <nop test="stalled" next="fallback"/>
  <nop next="poll"/>
  <!-- (a nop's actions run whether or not its test passes, so the log sits -->
  <!-- behind its own label)                                                -->
  <label id="fallback"/>
  <nop next="next_section">
    <action><log message="FLOW caller: no re-INVITE 32s after section [$k] ended - moving on"/></action>
  </nop>
  <label id="tick_last"/>
  <nop test="ended" next="send_bye"/>
  <nop next="poll"/>

  <!-- ==================================================================== -->
  <!-- Any re-INVITE: answer to match its direction, then pick the section. -->
  <!-- ==================================================================== -->
  <label id="reinv"/>
  <nop>
    <action>
      <gettimeofday assign_to="t_s,t_us"/>
      <assign assign_to="now" value="0"/>
      <add assign_to="now" variable="t_s"/>
      <assign assign_to="t_frac" value="0"/>
      <add assign_to="t_frac" variable="t_us"/>
      <divide assign_to="t_frac" value="1000000"/>
      <add assign_to="now" variable="t_frac"/>
      <log message="FLOW caller: re-INVITE in section [$k] sendonly=[$offer_sendonly] inactive=[$offer_inactive]"/>
    </action>
  </nop>
  <nop test="offer_sendonly" next="c_ans_recvonly"/>
  <nop test="offer_inactive" next="c_ans_inactive"/>

  <label id="c_ans_sendrecv"/>
  <!-- Normal (agent connect, merge or media re-point) -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 87308505 2 IN IP[local_ip_type] [local_ip]
      s=-
      t=0 0
      c=IN IP[media_ip_type] [media_ip]
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=sendrecv
    ]]>
  </send>
  <recv request="ACK" crlf="true">
  </recv>
  <nop>
    <action>
      <test assign_to="no_section" variable="k" compare="equal" value="0"/>
      <assign assign_to="elapsed" value="0"/>
      <add assign_to="elapsed" variable="now"/>
      <subtract assign_to="elapsed" variable="sstart"/>
      <test assign_to="in_window" variable="elapsed" compare="less_than" value="35"/>
      <assign assign_to="to_end" value="0"/>
      <add assign_to="to_end" variable="elapsed"/>
      <subtract assign_to="to_end" variable="cur_len"/>
      <test assign_to="near_end" variable="to_end" compare="greater_than_equal" value="-3"/>
      <test assign_to="is_last" variable="k" compare="greater_than_equal" value="__SECTIONS__"/>
    </action>
  </nop>
  <!-- Moving on wins near a section's end; otherwise a re-INVITE early in -->
  <!-- a section restarts it (the connect after a hold or re-point).        -->
  <nop test="no_section" next="start_1"/>
  <nop test="is_last" next="reinv_last"/>
  <nop test="near_end" next="next_section"/>
  <nop test="in_window" next="restart_section"/>
  <nop next="poll"/>
  <label id="reinv_last"/>
  <nop test="in_window" next="restart_section"/>
  <nop next="poll"/>

  <label id="c_ans_recvonly"/>
  <!-- Hold (offer a=sendonly) -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 87308505 2 IN IP[local_ip_type] [local_ip]
      s=-
      t=0 0
      c=IN IP[media_ip_type] [media_ip]
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=recvonly
    ]]>
  </send>
  <nop next="held_ack"/>

  <label id="c_ans_inactive"/>
  <!-- Hold (offer a=inactive) -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 87308505 2 IN IP[local_ip_type] [local_ip]
      s=-
      t=0 0
      c=IN IP[media_ip_type] [media_ip]
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=inactive
    ]]>
  </send>
  <label id="held_ack"/>
  <recv request="ACK" crlf="true" next="poll">
  </recv>

  <!-- ==================================================================== -->
  <!-- Section starts: restart the current one or move to the next.        -->
  <!-- ==================================================================== -->
  <label id="restart_section"/>
  <nop>
    <action>
      <test assign_to="k_is_1" variable="k" compare="equal" value="1"/>
      <test assign_to="k_is_2" variable="k" compare="equal" value="2"/>
      <test assign_to="k_is_3" variable="k" compare="equal" value="3"/>
      <test assign_to="k_is_4" variable="k" compare="equal" value="4"/>
      <test assign_to="k_is_5" variable="k" compare="equal" value="5"/>
    </action>
  </nop>
  <nop test="k_is_1" next="start_1"/>
  <nop test="k_is_2" next="start_2"/>
  <nop test="k_is_3" next="start_3"/>
  <nop test="k_is_4" next="start_4"/>
  <nop test="k_is_5" next="start_5"/>
  <nop next="start_6"/>

  <label id="next_section"/>
  <nop>
    <action>
      <test assign_to="k_is_1" variable="k" compare="equal" value="1"/>
      <test assign_to="k_is_2" variable="k" compare="equal" value="2"/>
      <test assign_to="k_is_3" variable="k" compare="equal" value="3"/>
      <test assign_to="k_is_4" variable="k" compare="equal" value="4"/>
    </action>
  </nop>
  <nop test="k_is_1" next="start_2"/>
  <nop test="k_is_2" next="start_3"/>
  <nop test="k_is_3" next="start_4"/>
  <nop test="k_is_4" next="start_5"/>
  <nop next="start_6"/>

  <label id="start_1"/>
  <nop next="poll">
    <action>
      <assign assign_to="k" value="1"/>
      <assign assign_to="cur_len" value="__LEN1__"/>
      <assign assign_to="sstart" value="0"/>
      <add assign_to="sstart" variable="now"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=__PCAP1__.pcap stage=section-1"/>
      <exec play_pcap_audio="pcaps/__PCAP1__.pcap"/>
    </action>
  </nop>
  <label id="start_2"/>
  <nop next="poll">
    <action>
      <assign assign_to="k" value="2"/>
      <assign assign_to="cur_len" value="__LEN2__"/>
      <assign assign_to="sstart" value="0"/>
      <add assign_to="sstart" variable="now"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=__PCAP2__.pcap stage=section-2"/>
      <exec play_pcap_audio="pcaps/__PCAP2__.pcap"/>
    </action>
  </nop>
  <label id="start_3"/>
  <nop next="poll">
    <action>
      <assign assign_to="k" value="3"/>
      <assign assign_to="cur_len" value="__LEN3__"/>
      <assign assign_to="sstart" value="0"/>
      <add assign_to="sstart" variable="now"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=__PCAP3__.pcap stage=section-3"/>
      <exec play_pcap_audio="pcaps/__PCAP3__.pcap"/>
    </action>
  </nop>
  <label id="start_4"/>
  <nop next="poll">
    <action>
      <assign assign_to="k" value="4"/>
      <assign assign_to="cur_len" value="__LEN4__"/>
      <assign assign_to="sstart" value="0"/>
      <add assign_to="sstart" variable="now"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=__PCAP4__.pcap stage=section-4"/>
      <exec play_pcap_audio="pcaps/__PCAP4__.pcap"/>
    </action>
  </nop>
  <label id="start_5"/>
  <nop next="poll">
    <action>
      <assign assign_to="k" value="5"/>
      <assign assign_to="cur_len" value="__LEN5__"/>
      <assign assign_to="sstart" value="0"/>
      <add assign_to="sstart" variable="now"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=__PCAP5__.pcap stage=section-5"/>
      <exec play_pcap_audio="pcaps/__PCAP5__.pcap"/>
    </action>
  </nop>
  <label id="start_6"/>
  <nop next="poll">
    <action>
      <assign assign_to="k" value="6"/>
      <assign assign_to="cur_len" value="__LEN6__"/>
      <assign assign_to="sstart" value="0"/>
      <add assign_to="sstart" variable="now"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=__PCAP6__.pcap stage=section-6"/>
      <exec play_pcap_audio="pcaps/__PCAP6__.pcap"/>
    </action>
  </nop>

  <!-- Far end hung up: acknowledge the BYE and finish. -->
  <label id="peer_bye"/>
  <send next="call_done">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Length: 0

    ]]>
  </send>

  <!-- We hang up: end of the conversation with B, or no agent ever came. -->
  <label id="send_bye"/>
  <send retrans="500">
    <![CDATA[

      BYE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0 file="random_caller_ids.csv"] <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: sut <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: sip:[field1 file="random_caller_ids.csv"]@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>
  <recv response="200" crlf="true" timeout="5000" ontimeout="call_done">
  </recv>

  <label id="call_done"/>

  <ResponseTimeRepartition value="2, 5, 10, 20, 30, 40, 50, 60, 70, 80, 100, 125, 150, 175, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 2000"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>
</scenario>
