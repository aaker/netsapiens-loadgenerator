<!--           Sipp UAS scenario with Opus and G.711a fallback.         -->
<!--                                                                    -->

<scenario name="UAS responder with Opus and G.711a fallback">
  <!-- By adding rrs="true" (Record Route Sets), the route sets         -->
  <!-- are saved and used for following messages sent. Useful to test   -->
  <!-- against stateful SIP proxies/B2BUAs.                             -->

  <recv request="INVITE" crlf="true" rrs="true">
    <action>
      <ereg regexp=".*" search_in="hdr" header="From" assign_to="remote_from"/>
      <ereg regexp="sip:(.*)>.*" search_in="hdr" header="Contact" assign_to="remote_contact"/>
      <!-- Non-empty if caller offered OPUS (PT 121) -->
      <ereg regexp="a=rtpmap:121" search_in="body" assign_to="opus_offered" checkIt="false"/>
      <!-- Match last digit of Call-ID numeric prefix against __OPUS_REGEX__ (injected        -->
      <!-- by register.sh/manual_test.sh via sed from OPUS_PCT, 10% granularity).           -->
      <!-- e.g. OPUS_PCT=90 → [0-8] matches digits 0-8 (90% of calls → Opus).              -->
      <ereg regexp="(__OPUS_REGEX__)-[0-9a-f]" search_in="hdr" header="Call-ID" assign_to="use_opus,use_opus" checkIt="false"/>
    </action>
  </recv>

  <!-- The '[last_*]' keyword is replaced automatically by the          -->
  <!-- specified header if it was present in the last message received  -->
  <!-- (except if it was a retransmission). If the header was not       -->
  <!-- present or if no message has been received, the '[last_*]'       -->
  <!-- keyword is discarded, and all bytes until the end of the line    -->
  <!-- are also discarded.                                              -->
  <!--                                                                  -->
  <!-- If the specified header was present several times in the         -->
  <!-- message, all occurences are concatenated (CRLF seperated)        -->
  <!-- to be used in place of the '[last_*]' keyword.                   -->

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>

    ]]>
  </send>

  <pause distribution="uniform" min="1000" max="5000"/>


  <nop>
    <action>
      <log message="CODEC opus_offered=[$opus_offered] use_opus=[$use_opus]"/>
    </action>
  </nop>

  <!-- Branch: OPUS offered AND bucket in Opus range → OPUS 200 OK, else → G.711a 200 OK -->
  <nop test="opus_offered" next="check_pct"/>
  <nop>
    <action><log message="CODEC path=g711a_not_offered"/></action>
  </nop>
  <nop next="200ok_g711a"/>

  <label id="check_pct"/>
  <nop test="use_opus" next="200ok_opus"/>
  <nop>
    <action><log message="CODEC path=g711a_pct_bucket use_opus=[$use_opus]"/></action>
  </nop>

  <!-- G.711a 200 OK -->
  <label id="200ok_g711a"/>
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      User-Agent: sipp Simulated Agent
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15

    ]]>
  </send>
  <nop>
    <action><assign assign_to="codec_opus" value="0"/></action>
  </nop>
  <nop next="recv_ack"/>

  <!-- OPUS 200 OK -->
  <label id="200ok_opus"/>
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 121 101
      a=rtpmap:121 opus/48000/2
      a=fmtp:121 minptime=10;useinbandfec=1
      a=rtpmap:101 telephone-event/48000
      a=fmtp:101 0-15

    ]]>
  </send>
  <nop>
    <action><assign assign_to="codec_opus" value="1"/></action>
  </nop>

  <label id="recv_ack"/>
  <recv request="ACK"
        rtd="true"
        crlf="true">
  </recv>

  <!-- RTP playback driven by codec_opus (what we actually negotiated, not just what was offered) -->
  <nop test="codec_opus" next="play_opus"/>
  <nop>
    <action>
      <exec play_pcap_audio="g711a.pcap"/>
    </action>
  </nop>
  <nop next="wait_bye"/>

  <label id="play_opus"/>
  <nop>
    <action>
      <exec play_pcap_audio="sip-rtp-opus-121.pcap"/>
    </action>
  </nop>

  <label id="wait_bye"/>
  <recv request="BYE" timeout="400000" ontimeout="send_bye" ></recv>
  <send next="99">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>


  <label id="send_bye"/>
  <!-- send bye -->
   <send retrans="1000">
    <![CDATA[
    BYE [$remote_contact] SIP/2.0
    Via: SIP/2.0/[transport] [local_ip]:[local_port]
    From: sipp  <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag01[call_number]
    To: [$remote_from]
    Call-ID: [call_id]
    Cseq: 2 BYE
    Contact: sip:[local_ip]:[local_port]
    Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true" next="99">
  </recv>



  <label id="3"/>



  <!-- Keep the call open for a while in case the 200 is lost to be     -->
  <!-- able to retransmit it if we receive the BYE again.               -->
  <label id="99"/>
  <timewait milliseconds="5000"/>


  <!-- definition of the response time repartition table (unit is ms)   -->
  <ResponseTimeRepartition value="2, 5, 10, 20, 30, 40, 50, 60, 70, 80, 100, 125, 150, 175, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 2000"/>

  <!-- definition of the call length repartition table (unit is ms)     -->
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>

</scenario>
