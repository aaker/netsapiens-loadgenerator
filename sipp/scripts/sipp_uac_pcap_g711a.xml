<!--                 Sipp 'uac' scenario with pcap (rtp) play           -->
<!--                                                                    -->

<scenario name="UAC with media">
  <!-- In client mode (sipp placing calls), the Call-ID MUST be         -->
  <!-- generated by sipp. To do so, use [call_id] keyword.                -->

  <!-- Send OPTIONS request to check server availability -->
  <send retrans="500" start_rtd="option">
    <![CDATA[

      OPTIONS sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 OPTIONS
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" rtd="option">
  </recv>

  <send retrans="500" start_rtd="invite">
    <![CDATA[

      INVITE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "[field0 file="random_caller_ids.csv"]" <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: sip:sipp@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[local_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-11,16

    ]]>
  </send>

  <recv response="100" rtd="invite" optional="true">
  </recv>

  <recv response="180" optional="true">
  </recv>

  <!-- By adding rrs="true" (Record Route Sets), the route sets         -->
  <!-- are saved and used for following messages sent. Useful to test   -->
  <!-- against stateful SIP proxies/B2BUAs.                             -->
  <recv response="200" crlf="true">
  </recv>

  <!-- Packet lost can be simulated in any send/recv message by         -->
  <!-- by adding the 'lost = "10"'. Value can be [1-100] percent.       -->
  <send>
    <![CDATA[

      ACK sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0 file="random_caller_ids.csv"] <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: sut <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: sip:[field1 file="random_caller_ids.csv"]@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Subject: Performance Test
      Content-Length: 0

    ]]>
  </send>

  <!-- Pre-agent stage (AA/MOH): the platform expects media from us, but   -->
  <!-- no agent is listening yet, so stream SILENCE rather than real       -->
  <!-- speech.  Caller speech starts at talk_leg when an agent connects.   -->
  <nop>
    <action>
      <!-- log lines only emit under -trace_logs (manual_test.sh); cron is unaffected -->
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-silence.pcap stage=pre-agent"/>
      <exec play_pcap_audio="g711a-silence.pcap"/>
    </action>
  </nop>

  <!-- send rfc2833 DTMF.  NOTE: rtp_send_dtmf shares the pcap-audio media -->
  <!-- thread, so it KILLS the running playback - which is why silence is  -->
  <!-- restarted right after the digit below.                              -->
  <nop>
    <pause distribution="uniform" min="100" max="1000"/>
    <action>
      <exec rtp_send_dtmf="1" />
    </action>
  </nop>

  <!-- Let the DTMF digit finish, then resume the silence stream so RTP    -->
  <!-- keeps flowing until the agent-connect re-INVITE starts real speech. -->
  <!-- Kept short: a re-INVITE landing during a blocking pause would be    -->
  <!-- auto-BYEd (see below), and the agent can connect from ~1s onward.   -->
  <pause milliseconds="300"/>
  <nop>
    <action>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-silence.pcap stage=post-dtmf"/>
      <exec play_pcap_audio="g711a-silence.pcap"/>
    </action>
  </nop>


  <!-- Initialise the leg counter that bounds how many re-INVITEs we follow.  -->
  <nop>
    <action><assign assign_to="reinvite_legs" value="0"/></action>
  </nop>

  <!-- ====================================================================== -->
  <!-- Follow the call through agent delivery AND queue transfers.            -->
  <!-- The platform sends an in-dialog re-INVITE whenever the call is          -->
  <!-- (re)connected to an agent: once for the initial queue->agent delivery,  -->
  <!-- and again ~90s later for each transfer our UAS performs.  We answer     -->
  <!-- every one of them (so the call follows the transfer) using a recv-based -->
  <!-- wait - NOT a blocking <pause> - because a re-INVITE that lands during a -->
  <!-- pause is treated as "unexpected" and SIPp's default behaviour auto-BYEs -->
  <!-- it (the CSeq-103 / 481 failure seen in the trace).                      -->
  <!--                                                                         -->
  <!-- Each leg: play media, talk a random slice (kept under the ~90s transfer -->
  <!-- cadence so it never overlaps the next re-INVITE), then watch for the    -->
  <!-- next transfer re-INVITE.  If it arrives we follow it; if the watch      -->
  <!-- window elapses we hang up.  reinvite_legs caps the chain so the call    -->
  <!-- can't bounce forever (the transfer target oscillates 4000<->4001).      -->
  <!--                                                                         -->
  <!-- Tunables: pause min/max = per-leg talk; the BYE recv timeout below =    -->
  <!-- how long after talking we wait for a transfer before hanging up (raise  -->
  <!-- it to follow more transfers, lower it for shorter calls); cap value="8".-->
  <!-- ====================================================================== -->
  <recv request="INVITE" timeout="45000" ontimeout="send_bye" crlf="true" next="answer_reinvite">
  </recv>

  <!-- Answer a re-INVITE (agent connect or a transfer) with our media. -->
  <label id="answer_reinvite"/>
  <nop>
    <action>
      <add assign_to="reinvite_legs" value="1"/>
      <test assign_to="reinvite_cap" variable="reinvite_legs" compare="greater_than_equal" value="8"/>
    </action>
  </nop>
  <send retrans="500" next="reinvite_ack">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 87308505 2 IN IP[local_ip_type] [local_ip]
      s=-
      t=0 0
      c=IN IP[media_ip_type] [media_ip]
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
    ]]>
  </send>
  <label id="reinvite_ack"/>
  <recv request="ACK" crlf="true">
  </recv>
  <!-- Stop following once we've handled enough legs; hang up ourselves. -->
  <nop test="reinvite_cap" next="send_bye"/>

  <!-- Start caller media IMMEDIATELY on answering the re-INVITE.  The old      -->
  <!-- design only reached playback via the settle block's 8s ontimeout, so     -->
  <!-- the orig side sat silent for ~8s after every agent connect while the     -->
  <!-- term side streamed right away.  play_pcap_audio is non-blocking, so RTP  -->
  <!-- starts now and streams through the settle window and talk pause below.   -->
  <!-- Leg 1 = initial queue->agent delivery (orig segment 1); legs 2+ follow   -->
  <!-- a transfer (orig segment 2).                                             -->
  <label id="talk_leg"/>
  <nop>
    <action>
      <test assign_to="xfer_leg" variable="reinvite_legs" compare="greater_than_equal" value="2"/>
    </action>
  </nop>
  <nop test="xfer_leg" next="talk_post_transfer"/>
  <nop next="settle">
    <action>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-orig.pcap leg=[$reinvite_legs] stage=agent1"/>
      <exec play_pcap_audio="g711a-orig.pcap"/>
    </action>
  </nop>
  <label id="talk_post_transfer"/>
  <nop>
    <action>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-orig2.pcap leg=[$reinvite_legs] stage=post-transfer"/>
      <exec play_pcap_audio="g711a-orig2.pcap"/>
    </action>
  </nop>

  <!-- Settle: at a transfer the platform sends a media re-point re-INVITE      -->
  <!-- then the new-agent connect back to back.  Absorb such a quickly-          -->
  <!-- following re-INVITE here (re-enter answer_reinvite, which restarts        -->
  <!-- media) BEFORE the blocking talk pause, so it is never treated as          -->
  <!-- "unexpected" (the CSeq-103/481 failure).  Audio is already playing, so    -->
  <!-- this window no longer gates the start of media - it just quiesces.        -->
  <!-- Both recvs carry an explicit timeout so the per-recv timer fires          -->
  <!-- instead of the global -recv_timeout auto-BYE (which the proxy 481s).      -->
  <label id="settle"/>
  <recv request="INVITE" optional="true" timeout="8000" ontimeout="talk_pause" crlf="true" next="answer_reinvite">
  </recv>
  <recv request="BYE" timeout="8000" ontimeout="talk_pause" crlf="true" next="peer_bye">
  </recv>

  <!-- Random talk length: short pauses hang up (send_bye) before the ~90s      -->
  <!-- transfer mark; long ones survive into the recv window and follow the      -->
  <!-- transfer re-INVITE.  This is what keeps call durations varied and means   -->
  <!-- not every call reaches the transfer.                                      -->
  <label id="talk_pause"/>
  <pause distribution="uniform" min="5000" max="80000"/>
  <recv request="INVITE" optional="true" timeout="30000" ontimeout="send_bye" crlf="true" next="answer_reinvite">
  </recv>
  <recv request="BYE" timeout="30000" ontimeout="send_bye" crlf="true" next="peer_bye">
  </recv>

  <!-- Far end hung up: acknowledge the BYE and finish. -->
  <label id="peer_bye"/>
  <send next="call_done">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Length: 0

    ]]>
  </send>

  <!-- The UAC initiates the hangup (talk window elapsed or leg cap reached). -->
  <label id="send_bye"/>
  <send retrans="500" next="our_bye_200" >
    <![CDATA[

      BYE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0 file="random_caller_ids.csv"] <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: sut <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: sip:[field1 file="random_caller_ids.csv"]@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <label id="our_bye_200"/>
  <recv response="200" crlf="true" next="call_done">
  </recv>

  <label id="call_done"/>



  <!-- definition of the response time repartition table (unit is ms)   -->
  <ResponseTimeRepartition value="2, 5, 10, 20, 30, 40, 50, 60, 70, 80, 100, 125, 150, 175, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 2000"/>

  <!-- definition of the call length repartition table (unit is ms)     -->
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>

</scenario>


