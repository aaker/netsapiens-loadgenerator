<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- ====================================================================== -->
<!-- Attended (supervised) transfer - caller side (UAC).                    -->
<!--                                                                        -->
<!-- Same call setup as sipp_uac_pcap_g711a.xml (DID INVITE, pre-agent      -->
<!-- silence + DTMF), then follows the agents in sipp_uas_attended.xml:     -->
<!--   1. agent A connects (re-INVITE): play g711a-att-orig.pcap (44s)      -->
<!--   2. A holds us (re-INVITE a=sendonly/inactive): answer recvonly/      -->
<!--      inactive and stay quiet while A consults agent B                  -->
<!--   3. the merge (a sendrecv re-INVITE after the hold, or 32s after      -->
<!--      section 1 if none comes): play g711a-att-orig2.pcap (60s), then   -->
<!--      hang up                                                           -->
<!--                                                                        -->
<!-- Every wait is a recv with a timeout rather than a <pause>, so a        -->
<!-- re-INVITE can arrive at any point without being auto-BYEd.  Each wait  -->
<!-- resets the hold flags first: an ereg that does not match leaves the    -->
<!-- variable as it was.  phase:                                            -->
<!--   0 waiting for agent A, 1 talking to A, 2 waiting for the merge,      -->
<!--   3 talking to B.                                                      -->
<!-- Used by manual_test.sh flow mode attended.                             -->
<!-- ====================================================================== -->

<scenario name="UAC attended transfer (caller)">

  <!-- Send OPTIONS request to check server availability -->
  <send retrans="500" start_rtd="option">
    <![CDATA[

      OPTIONS sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 OPTIONS
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" rtd="option">
  </recv>

  <send retrans="500" start_rtd="invite">
    <![CDATA[

      INVITE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "[field0 file="random_caller_ids.csv"]" <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: sip:sipp@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[local_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-11,16

    ]]>
  </send>

  <recv response="100" rtd="invite" optional="true">
  </recv>

  <recv response="180" optional="true">
  </recv>

  <!-- By adding rrs="true" (Record Route Sets), the route sets         -->
  <!-- are saved and used for following messages sent. Useful to test   -->
  <!-- against stateful SIP proxies/B2BUAs.                             -->
  <recv response="200" crlf="true">
  </recv>

  <!-- Packet lost can be simulated in any send/recv message by         -->
  <!-- by adding the 'lost = "10"'. Value can be [1-100] percent.       -->
  <send>
    <![CDATA[

      ACK sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0 file="random_caller_ids.csv"] <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: sut <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: sip:[field1 file="random_caller_ids.csv"]@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Subject: Performance Test
      Content-Length: 0

    ]]>
  </send>

  <!-- Pre-agent stage (AA/MOH): the platform expects media from us, but   -->
  <!-- no agent is listening yet, so stream SILENCE rather than real       -->
  <!-- speech.  Caller speech starts at talk_leg when an agent connects.   -->
  <nop>
    <action>
      <!-- log lines only emit under -trace_logs (manual_test.sh); cron is unaffected -->
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-silence.pcap stage=pre-agent"/>
      <exec play_pcap_audio="g711a-silence.pcap"/>
    </action>
  </nop>

  <!-- send rfc2833 DTMF.  NOTE: rtp_send_dtmf shares the pcap-audio media -->
  <!-- thread, so it KILLS the running playback - which is why silence is  -->
  <!-- restarted right after the digit below.                              -->
  <nop>
    <pause distribution="uniform" min="100" max="1000"/>
    <action>
      <exec rtp_send_dtmf="1" />
    </action>
  </nop>

  <!-- Let the DTMF digit finish, then resume the silence stream so RTP    -->
  <!-- keeps flowing until the agent-connect re-INVITE starts real speech. -->
  <!-- Kept short: a re-INVITE landing during a blocking pause would be    -->
  <!-- auto-BYEd (see below), and the agent can connect from ~1s onward.   -->
  <pause milliseconds="300"/>
  <nop>
    <action>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-silence.pcap stage=post-dtmf"/>
      <exec play_pcap_audio="g711a-silence.pcap"/>
    </action>
  </nop>

  <nop>
    <action>
      <assign assign_to="phase" value="0"/>
      <assign assign_to="held" value="0"/>
    </action>
  </nop>

  <!-- Waiting for agent A. -->
  <label id="c_wait_agent"/>
  <nop>
    <action>
      <assign assign_to="offer_sendonly" value="0"/>
      <assign assign_to="offer_inactive" value="0"/>
    </action>
  </nop>
  <recv timeout="45000" ontimeout="send_bye" request="BYE" optional="true" next="peer_bye">
  </recv>
  <recv request="INVITE" timeout="45000" ontimeout="send_bye" crlf="true" next="c_reinv">
    <action>
      <ereg regexp="a=sendonly" search_in="body" assign_to="offer_sendonly" checkIt="false"/>
      <ereg regexp="a=inactive" search_in="body" assign_to="offer_inactive" checkIt="false"/>
    </action>
  </recv>

  <!-- Section 1: talking to A. -->
  <label id="c_talk1"/>
  <nop>
    <action>
      <assign assign_to="phase" value="1"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-att-orig.pcap stage=agent-a"/>
      <exec play_pcap_audio="g711a-att-orig.pcap"/>
    </action>
  </nop>
  <label id="c_wait_talk1"/>
  <nop>
    <action>
      <assign assign_to="offer_sendonly" value="0"/>
      <assign assign_to="offer_inactive" value="0"/>
    </action>
  </nop>
  <recv timeout="44500" ontimeout="c_wait_merge_enter" request="BYE" optional="true" next="peer_bye">
  </recv>
  <recv request="INVITE" timeout="44500" ontimeout="c_wait_merge_enter" crlf="true" next="c_reinv">
    <action>
      <ereg regexp="a=sendonly" search_in="body" assign_to="offer_sendonly" checkIt="false"/>
      <ereg regexp="a=inactive" search_in="body" assign_to="offer_inactive" checkIt="false"/>
    </action>
  </recv>

  <!-- On hold (or past section 1): wait for the merge. -->
  <label id="c_wait_merge_enter"/>
  <nop>
    <action><assign assign_to="phase" value="2"/></action>
  </nop>
  <label id="c_wait_merge"/>
  <nop>
    <action>
      <assign assign_to="offer_sendonly" value="0"/>
      <assign assign_to="offer_inactive" value="0"/>
    </action>
  </nop>
  <recv timeout="32000" ontimeout="c_talk2" request="BYE" optional="true" next="peer_bye">
  </recv>
  <recv request="INVITE" timeout="32000" ontimeout="c_talk2" crlf="true" next="c_reinv">
    <action>
      <ereg regexp="a=sendonly" search_in="body" assign_to="offer_sendonly" checkIt="false"/>
      <ereg regexp="a=inactive" search_in="body" assign_to="offer_inactive" checkIt="false"/>
    </action>
  </recv>

  <!-- Section 3: talking to B, then hang up. -->
  <label id="c_talk2"/>
  <nop>
    <action>
      <assign assign_to="phase" value="3"/>
      <log message="__PCAP__ call=[call_number] tick=[clock_tick]ms play=g711a-att-orig2.pcap stage=agent-b held=[$held]"/>
      <exec play_pcap_audio="g711a-att-orig2.pcap"/>
    </action>
  </nop>
  <label id="c_wait_talk2"/>
  <nop>
    <action>
      <assign assign_to="offer_sendonly" value="0"/>
      <assign assign_to="offer_inactive" value="0"/>
    </action>
  </nop>
  <recv timeout="60500" ontimeout="send_bye" request="BYE" optional="true" next="peer_bye">
  </recv>
  <recv request="INVITE" timeout="60500" ontimeout="send_bye" crlf="true" next="c_reinv">
    <action>
      <ereg regexp="a=sendonly" search_in="body" assign_to="offer_sendonly" checkIt="false"/>
      <ereg regexp="a=inactive" search_in="body" assign_to="offer_inactive" checkIt="false"/>
    </action>
  </recv>

  <!-- ==================================================================== -->
  <!-- Any re-INVITE: answer to match its direction, then carry on in the   -->
  <!-- current phase (or advance it).                                       -->
  <!-- ==================================================================== -->
  <label id="c_reinv"/>
  <nop>
    <action>
      <log message="ATT caller: re-INVITE phase=[$phase] sendonly=[$offer_sendonly] inactive=[$offer_inactive]"/>
    </action>
  </nop>
  <nop test="offer_sendonly" next="c_ans_recvonly"/>
  <nop test="offer_inactive" next="c_ans_inactive"/>

  <label id="c_ans_sendrecv"/>
  <!-- Normal (agent connect, merge or media re-point) -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 87308505 2 IN IP[local_ip_type] [local_ip]
      s=-
      t=0 0
      c=IN IP[media_ip_type] [media_ip]
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=sendrecv
    ]]>
  </send>
  <recv request="ACK" crlf="true">
  </recv>
  <nop>
    <action>
      <test assign_to="in_phase0" variable="phase" compare="equal" value="0"/>
      <test assign_to="in_phase1" variable="phase" compare="equal" value="1"/>
      <test assign_to="in_phase2" variable="phase" compare="equal" value="2"/>
      <test assign_to="was_held" variable="held" compare="equal" value="1"/>
    </action>
  </nop>
  <nop test="in_phase0" next="c_talk1"/>
  <nop test="in_phase1" next="c_wait_talk1"/>
  <nop test="in_phase2" next="c_after_hold"/>
  <nop next="c_wait_talk2"/>
  <!-- In phase 2 a sendrecv re-INVITE after a hold is the merge. -->
  <label id="c_after_hold"/>
  <nop test="was_held" next="c_talk2"/>
  <nop next="c_wait_merge"/>

  <label id="c_ans_recvonly"/>
  <!-- Hold (offer a=sendonly) -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 87308505 2 IN IP[local_ip_type] [local_ip]
      s=-
      t=0 0
      c=IN IP[media_ip_type] [media_ip]
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=recvonly
    ]]>
  </send>
  <nop next="c_held"/>

  <label id="c_ans_inactive"/>
  <!-- Hold (offer a=inactive) -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 87308505 2 IN IP[local_ip_type] [local_ip]
      s=-
      t=0 0
      c=IN IP[media_ip_type] [media_ip]
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=inactive
    ]]>
  </send>

  <label id="c_held"/>
  <recv request="ACK" crlf="true">
  </recv>
  <nop>
    <action>
      <assign assign_to="held" value="1"/>
      <test assign_to="talking_b" variable="phase" compare="equal" value="3"/>
    </action>
  </nop>
  <nop test="talking_b" next="c_wait_talk2"/>
  <nop next="c_wait_merge_enter"/>

  <!-- Far end hung up: acknowledge the BYE and finish. -->
  <label id="peer_bye"/>
  <send next="call_done">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Content-Length: 0

    ]]>
  </send>

  <!-- We hang up: end of the conversation with B, or no agent ever came. -->
  <label id="send_bye"/>
  <send retrans="500">
    <![CDATA[

      BYE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [field0 file="random_caller_ids.csv"] <sip:[field1 file="random_caller_ids.csv"]@inbound-carrier>;tag=[call_number]
      To: sut <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: sip:[field1 file="random_caller_ids.csv"]@[local_ip]:[local_port]
      User-Agent: netsapiens-loadgenerator ([ua_version])
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>
  <recv response="200" crlf="true" timeout="5000" ontimeout="call_done">
  </recv>

  <label id="call_done"/>

  <ResponseTimeRepartition value="2, 5, 10, 20, 30, 40, 50, 60, 70, 80, 100, 125, 150, 175, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 2000"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>
</scenario>
