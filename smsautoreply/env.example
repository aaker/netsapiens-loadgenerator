# ---------------------------------------------------------------------------
# Bandwidth.com credentials
# ---------------------------------------------------------------------------
# Numeric account id from the Bandwidth dashboard (e.g. 5000123)
BW_ACCOUNT_ID=
# Messaging API credentials (Account -> API Credentials -> Messaging API).
# These are NOT the dashboard username/password.
BW_API_TOKEN=
BW_API_SECRET=
# Messaging application id that owns the number the webhook fires for
BW_APPLICATION_ID=
# Base URL for the Messaging API (change only for a non-US region)
BW_MESSAGING_BASE_URL=https://messaging.bandwidth.com/api/v2

# Optional: E.164 number to send replies from. Leave blank to reply from the
# number the inbound message was addressed to (the usual behaviour).
BW_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Inbound webhook authentication
# ---------------------------------------------------------------------------
# If set, the callback must present HTTP Basic auth with these values.
# Configure the same user/pass on the Bandwidth application's callback URL.
WEBHOOK_USERNAME=
WEBHOOK_PASSWORD=
# Optional shared secret required as ?token=... on the callback URL.
WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Service settings
# ---------------------------------------------------------------------------
PORT=3010
BIND_ADDRESS=127.0.0.1
# Path the webhook is served on (Apache proxies to this)
WEBHOOK_PATH=/webhooks/bandwidth/inbound
# Set to 1 to accept and log inbound messages without sending a reply
DRY_RUN=0
# Max characters of the echoed payload included in the reply body
REPLY_MAX_ECHO_CHARS=800
# debug | info | warn | error
LOG_LEVEL=info
# Trust X-Forwarded-For from the Apache reverse proxy
TRUST_PROXY=1

# Outbound API request timeout / retry count
BW_TIMEOUT_MS=10000
BW_RETRIES=2
