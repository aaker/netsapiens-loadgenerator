# --- Server ---
SIGNUP_PORT=3100
TRUST_PROXY=0                     # 1 = honor X-Forwarded-For (behind nginx/ELB)

# --- NetSapiens (falls back to repo root .env for these two) ---
TARGET_SERVER=                    # NetSapiens API hostname
APIKEY=                           # nss_...

# --- Inteliquent (Customer Portal > Admin > API Key) ---
INTELIQUENT_API_KEY=              # "API Key" — also sent as privateKey in request bodies
INTELIQUENT_API_SECRET=           # "API Secret"
INTELIQUENT_API_BASE=https://services.inteliquent.com/Services/2.0.0
INTELIQUENT_TOKEN_URL=https://services-token.inteliquent.com/oauth2/token
INTELIQUENT_TRUNK_GROUP=          # existing trunk group to assign purchased numbers to

# --- Welcome email (Send Email using Template endpoint) ---
WELCOME_TEMPLATE=custom_welcome_email_reseller.php
WELCOME_SUBJECT=New Account Setup

# --- Behavior ---
SIGNUP_DRY_RUN=0                  # 1 = skip Inteliquent entirely, use a fake number
SIGNUP_RATE_LIMIT_PER_HOUR=3      # signup POSTs per IP per hour
SIGNUP_RATE_LIMIT_GLOBAL_PER_DAY=20
API_DEBUG=0
