{
  "name": "netsapiens-signup",
  "version": "1.0.0",
  "description": "Beta tester self-service signup for a NetSapiens server",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "free-email-domains": "^1.9.64",
    "nodemailer": "^6.9.14"
  }
}
