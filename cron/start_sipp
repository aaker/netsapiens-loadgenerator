#this script is used to start the sipp load generator for registration. Running every 10 min and consolidates all CSV files per transport type (UDP at :00/:30, TCP at :10/:40, TLS at :20/:50).
*/10 * * * * root cd /usr/local/NetSapiens/netsapiens-loadgenerator/sipp/scripts/ && /usr/local/NetSapiens/netsapiens-loadgenerator/sipp/scripts/register_all.sh
#below schedules 5 min run times of the inbound script for each timezone, running 24/7.
#CPS is shaped by the time-based multiplier in inbound.sh (peaks at 11am/1pm local, 10% overnight).
#Set CPS_TZ_OFFSET in .env to match the server's reference timezone (default: -7 for PDT).
#Transport distribution: UDP (u1) on minutes 0,15,30,45; TCP (t1) on minutes 5,20,35,50; TLS (l1) on minutes 10,25,40,55 for even minute patterns
#Transport distribution: UDP (u1) on minutes 1,16,31,46; TCP (t1) on minutes 6,21,36,51; TLS (l1) on minutes 11,26,41,56 for odd minute patterns
#US_Hawaii (even pattern)
0,15,30,45 * * * * root /usr/local/NetSapiens/netsapiens-loadgenerator/sipp/scripts/inbound.sh "US_Hawaii" "u1" --server all
5,20,35,50 * * * * root /usr/local/NetSapiens/netsapiens-loadgenerator/sipp/scripts/inbound.sh "US_Hawaii" "t1" --server all
10,25,40,55 * * * * root /usr/local/NetSapiens/netsapiens-loadgenerator/sipp/scripts/inbound.sh "US_Hawaii" "l1" --server all
#US_Alaska (odd pattern)
